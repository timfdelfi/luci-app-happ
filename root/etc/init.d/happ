#!/bin/sh /etc/rc.common
# VPN (luci-app-happ): запуск sing-box под управлением procd

START=99
STOP=10
USE_PROCD=1

PIDFILE=/var/run/happ.pid

start_service() {
	[ "$(jq 'length' /etc/happ/servers.json 2>/dev/null)" -gt 0 ] 2>/dev/null || {
		mkdir -p /var/run/happ
		echo "Нет серверов — добавьте ссылку в разделе Службы → VPN" > /var/run/happ/last_error 2>/dev/null
		return 0
	}
	/usr/bin/happ prepare || return 0

	procd_open_instance happ
	procd_set_param command /usr/bin/happ run
	procd_set_param pidfile "$PIDFILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/bin/happ net-down
}

service_stopped() {
	/usr/bin/happ net-down
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger happ
}
